generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  posterUrl   String?
  description String
  duration    Int
  releaseDate DateTime
  genre       String
  language    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  shows       Show[]
}

model Show {
  id        Int      @id @default(autoincrement())
  startTime DateTime
  movieId   Int
  movie     Movie    @relation(fields: [movieId], references: [id])
  createdAt DateTime @default(now())
}
